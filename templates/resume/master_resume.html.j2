<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ data.header_top.line_1_name_header_text }} - Resume</title>
  <style>
    @page {
      size: Letter;
      margin: 0.805in 0.75in 0.722in;
    }

    :root {
      --emerald-accent: #57ba86;
      --emerald-dark: #047857;
      --body: #111827;
      --muted: #475569;
      --paper: #ffffff;
      --screen-bg: #eef2f0;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--screen-bg);
      color: var(--body);
      font-family: Helvetica, Arial, sans-serif;
      font-size: 8.8pt;
      line-height: 10.6pt;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .resume-page {
      width: 8.5in;
      min-height: 11in;
      margin: 24px auto;
      padding: 0.805in 0.75in 0.722in;
      background: var(--paper);
      box-shadow: 0 18px 60px rgba(15, 23, 42, 0.16);
    }

    .resume-top-rule {
      width: 100%;
      height: 2pt;
      margin: 0 0 12pt;
      background: var(--emerald-accent);
    }

    .resume-name {
      margin: 0 0 5pt;
      color: var(--emerald-dark);
      font-size: 13.2pt;
      font-weight: 700;
      line-height: 15.4pt;
    }

    .resume-contact {
      margin: 0 0 8pt;
      color: var(--muted);
      font-size: 7.2pt;
      font-weight: 700;
      line-height: 8.6pt;
    }

    .contact-separator {
      display: inline-block;
      padding: 0 3pt;
    }

    .resume-section {
      margin: 9pt 0 0;
    }

    .resume-section.with-rule {
      margin-top: 14pt;
    }

    .section-rule {
      width: 100%;
      height: 1.35pt;
      margin: 0 0 8pt;
      background: var(--emerald-accent);
    }

    .section-heading {
      margin: 0 0 6pt;
      color: var(--emerald-dark);
      font-size: 12.2pt;
      font-weight: 700;
      line-height: 14.2pt;
    }

    p {
      margin: 0 0 2pt;
    }

    .summary-note {
      margin-top: 2pt;
      color: var(--muted);
      font-size: 8pt;
      font-style: italic;
      line-height: 9.6pt;
    }

    .bullet-list {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .bullet-list > li {
      position: relative;
      margin: 0 0 1pt;
      padding-left: 0.32in;
    }

    .bullet-list > li::before {
      content: "\2022";
      position: absolute;
      left: 0.03in;
      top: 0;
      color: var(--body);
    }

    .nested-list {
      margin: 1pt 0 1pt 0.4in;
      padding: 0;
      list-style: none;
    }

    .nested-list > li {
      position: relative;
      margin: 0 0 1pt;
      padding-left: 0.32in;
    }

    .nested-list > li::before {
      content: "o";
      position: absolute;
      left: 0.06in;
      top: 0;
      color: var(--body);
      font-size: 8pt;
    }

    .job {
      margin: 0;
    }

    .job + .job {
      margin-top: 9pt;
    }

    .job-company {
      margin: 0 0 5pt;
      font-size: 9.5pt;
      font-weight: 700;
      line-height: 11.4pt;
    }

    .job-title {
      margin: 0 0 8pt;
      color: var(--muted);
      font-size: 8.6pt;
      font-weight: 700;
      line-height: 10.3pt;
    }

    .job-dates {
      font-style: italic;
    }

    .job-intro {
      margin: -4pt 0 5pt;
      color: var(--muted);
      font-style: italic;
    }

    strong {
      font-weight: 700;
    }

    @media print {
      body {
        background: var(--paper);
      }

      .resume-page {
        width: auto;
        min-height: auto;
        margin: 0;
        padding: 0;
        box-shadow: none;
      }

      .job,
      .education-item {
        break-inside: avoid;
      }
    }
  </style>
</head>
<body>
  {% set header = data.header_top | default({}) %}
  {% set summary = data.professional_summary | default({}) %}
  {% set skills = data.core_technical_skills | default({}) %}
  {% set experience = data.professional_experience | default({}) %}
  {% set education = data.education | default(data.education_and_certifications | default({}), true) %}
  {% set certifications = data.certifications | default({}) %}
  {% set portfolio = data.portfolio | default({}) %}

  {% macro linked(value) -%}
    {{- value | default("", true) | linkify -}}
  {%- endmacro %}

  {% macro bullet_text(bullet) -%}
    {%- if bullet is string -%}
      {{- bullet | linkify -}}
    {%- else -%}
      {%- set label = bullet.bold_label | default(bullet.category | default("", true), true) -%}
      {%- set body = bullet.text | default("", true) -%}
      {%- if not body -%}
        {%- set body = bullet | render_skill_items -%}
      {%- endif -%}
      {%- if not body -%}
        {%- set body = bullet.rendered_text | default("", true) -%}
      {%- endif -%}
      {%- if label -%}<strong>{{ label }}:</strong>{%- endif -%}
      {%- if body %} {{ body | linkify }}{%- endif -%}
    {%- endif -%}
  {%- endmacro %}

  <main class="resume-page">
    <div class="resume-top-rule"></div>

    {% if header.render | default(true) %}
      <header>
        <h1 class="resume-name">{{ header.line_1_name_header_text | default("", true) }}</h1>
        <p class="resume-contact">
          {% set links = header.links | default([]) %}
          {% set contact_items = header.contact_items | default([]) %}
          {% if contact_items %}
            {% for item in contact_items %}
              {% set matched_link = namespace(url=None) %}
              {% for link in links %}
                {% if item == link.label %}
                  {% set matched_link.url = link.url %}
                {% endif %}
              {% endfor %}
              {% if matched_link.url %}
                <a href="{{ matched_link.url }}">{{ item }}</a>
              {% else %}
                {{ item }}
              {% endif %}
              {% if not loop.last %}<span class="contact-separator">|</span>{% endif %}
            {% endfor %}
          {% elif header.line_2_applicant_info_text %}
            {{ header.line_2_applicant_info_text | linkify }}
          {% endif %}
        </p>
      </header>
    {% endif %}

    {% if summary.render | default(true) and (summary.paragraph | default("", true) or summary.summary_note | default("", true)) %}
      <section class="resume-section">
        <h2 class="section-heading">{{ summary.header_text | default("Professional Summary", true) }}</h2>
        {% if summary.paragraph | default("", true) %}
          <p>{{ linked(summary.paragraph) }}</p>
        {% endif %}
        {% if summary.summary_note | default("", true) %}
          <p class="summary-note">{{ linked(summary.summary_note) }}</p>
        {% endif %}
      </section>
    {% endif %}

    {% set skill_bullets = skills.bullet_points | default([]) %}
    {% if skills.render | default(true) and skill_bullets %}
      <section class="resume-section">
        <h2 class="section-heading">{{ skills.header_text | default("Core Technical Skills", true) }}</h2>
        <ul class="bullet-list">
          {% for bullet in skill_bullets %}
            <li>{{ bullet_text(bullet) }}</li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    {% set jobs = experience.jobs | default([]) %}
    {% if experience.render | default(true) and jobs %}
      <section class="resume-section with-rule">
        <div class="section-rule"></div>
        <h2 class="section-heading">{{ experience.header_text | default("Professional Experience", true) }}</h2>
        {% for job in jobs if job.render | default(true) %}
          {% set line_1 = job.line_1 | default({}) %}
          {% set line_2 = job.line_2 | default({}) %}
          {% set job_bullets = job.bullet_points | default([]) %}
          <article class="job">
            {% if line_1.company_name_text | default("", true) %}
              <h3 class="job-company">{{ line_1.company_name_text }}</h3>
            {% endif %}
            {% if line_1.position_name_text | default("", true) or line_1.position_dates_text | default("", true) %}
              <p class="job-title">
                {{ line_1.position_name_text | default("", true) }}
                {% if line_1.position_dates_text | default("", true) %}
                  | <span class="job-dates">{{ line_1.position_dates_text }}</span>
                {% endif %}
              </p>
            {% endif %}
            {% if line_2.position_intro_text | default("", true) %}
              <p class="job-intro">{{ linked(line_2.position_intro_text) }}</p>
            {% endif %}
            {% if job_bullets %}
              <ul class="bullet-list">
                {% for bullet in job_bullets if bullet is string or (bullet.render | default(true)) %}
                  <li>{{ bullet_text(bullet) }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          </article>
        {% endfor %}
      </section>
    {% endif %}

    {% set education_items = education.entries | default(education.get("items", []) if education.get is defined else []) %}
    {% if education.render | default(true) and education_items %}
      <section class="resume-section with-rule">
        <div class="section-rule"></div>
        <h2 class="section-heading">{{ education.header_text | default("Education", true) }}</h2>
        <ul class="bullet-list">
          {% for item in education_items if item is string or (item.render | default(true)) %}
            {% set details = item.details | default([]) %}
            {% set sub_items = item.sub_items | default([]) %}
            {% set entry_bullets = item.bullet_points | default([]) %}
            {% set line_1 = item.line_1 | default({}) %}
            {% set line_2 = item.line_2 | default({}) %}
            <li class="education-item">
              {% if item is string %}
                {{ linked(item) }}
              {% elif details %}
                <strong>{{ item.title }}:</strong> {{ details[0] | linkify }}
              {% elif line_1.institution_name_text | default("", true) or line_2.degree_name_text | default("", true) %}
                <strong>{{ line_1.institution_name_text | default("", true) }}:</strong>
                {{ line_2.degree_name_text | default("", true) }}
                {% if line_2.degree_dates_text | default("", true) %}
                  | <span class="job-dates">{{ line_2.degree_dates_text }}</span>
                {% endif %}
              {% else %}
                {{ linked(item.title | default(item.rendered_text | default("", true), true)) }}
              {% endif %}
              {% if entry_bullets %}
                <ul class="nested-list">
                  {% for entry_bullet in entry_bullets if entry_bullet is string or (entry_bullet.render | default(true)) %}
                    <li>{{ bullet_text(entry_bullet) }}</li>
                  {% endfor %}
                </ul>
              {% elif sub_items %}
                <ul class="nested-list">
                  {% for sub_item in sub_items %}
                    <li>
                      {% if sub_item.label | default("", true) %}
                        <em>{{ sub_item.label }}:</em>
                      {% endif %}
                      {{ linked(sub_item.text | default(sub_item, true)) }}
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    {% set certification_bullets = certifications.bullet_points | default([]) %}
    {% if certifications.render | default(true) and certification_bullets %}
      <section class="resume-section">
        <h2 class="section-heading">{{ certifications.header_text | default("Certifications", true) }}</h2>
        <ul class="bullet-list">
          {% for bullet in certification_bullets if bullet is string or (bullet.render | default(true)) %}
            <li>{{ bullet_text(bullet) }}</li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    {% set projects = portfolio.projects | default([]) %}
    {% if portfolio.render | default(true) and projects %}
      <section class="resume-section">
        <h2 class="section-heading">{{ portfolio.header_text | default("Portfolio", true) }}</h2>
        <ul class="bullet-list">
          {% for project in projects if project is string or (project.render | default(true)) %}
            <li>
              {% if project is string %}
                {{ linked(project) }}
              {% else %}
                {% set title = project.title_text | default(project.title | default("", true), true) %}
                {% set url = project.url | default("", true) %}
                {% set description = project.description_text | default(project.description | default("", true), true) %}
                {% if title %}<strong>{{ title }}:</strong>{% endif %}
                {% if url %} {{ linked(url) }}{% endif %}
                {% if description %} - {{ linked(description) }}{% endif %}
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}
  </main>
</body>
</html>
